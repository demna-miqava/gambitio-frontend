# Copy to .env.production (not committed). Used by `npm run build` for the
# Cloudflare deploy; overrides .env.

# Empty: the site and the API share one address on Cloudflare
# (see src/constants/apiConfig.ts).
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# The publishable key of your Clerk *production* instance (pk_live_...).
# Left empty, the build fails to log anyone in rather than quietly using the
# development key.
VITE_CLERK_PUBLISHABLE_KEY=

VITE_STOCKFISH_URL=/stockfish-17.1-lite-single-03e3232.js
